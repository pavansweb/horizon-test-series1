# ========================================================
# JEE MAIN CBT MOCK TEST PLATFORM - ENVIRONMENT VARIABLES
# ========================================================

# --------------------------------------------------------
# 1. Admin Authentication
# --------------------------------------------------------
# Master password for logging into the admin portal (/admin)
ADMIN_PASSWORD=your_secure_admin_password_here

# Secret key for encrypting and signing session tokens (32+ chars recommended)
SESSION_SECRET=super_secret_jee_mock_portal_session_key_2026_xyz

# --------------------------------------------------------
# 2. External Persistent Storage (Required for Vercel)
# --------------------------------------------------------
# Choose either Option A (Vercel Blob) or Option B (Supabase):

# OPTION A: Vercel Blob (Recommended for quick Vercel deployment)
# Created automatically by Vercel when you add a Blob store from the Storage tab
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx

# OPTION B: Supabase (Full Database + Object Storage)
# Get these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_BUCKET=jee-question-papers

# --------------------------------------------------------
# NOTE FOR LOCAL DEVELOPMENT:
# Neither Vercel Blob nor Supabase is required when running
# locally! The application automatically falls back to local
# file-based database (data/tests.json) and local uploads
# directory (public/uploads/) with zero external dependencies.
# --------------------------------------------------------
